# Base URL of the GuardGo API server (no trailing slash)
EXPO_PUBLIC_API_URL=http://192.168.1.236:8080


# Pusher Channels, for live job offers and alerts. The public key and cluster of the same Pusher app the
# backend uses (never the secret). Leave both empty to use polling only.
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=
